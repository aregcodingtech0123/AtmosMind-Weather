# Copy this file to .env and fill in your values. Do not commit .env.

# Set to "production" to disable FastAPI /docs, /redoc, and /openapi.json
# ENV=development

# Required for AI Weather Assistant (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: defaults shown
REDIS_PASSWORD=change_this_to_a_long_random_password
REDIS_URL=redis://:change_this_to_a_long_random_password@redis:6379
# Comma-separated browser origins allowed to call the API (CORS)
# ALLOWED_ORIGINS=https://atmosmindweather.com,https://www.atmosmindweather.com,http://localhost:3000
# Vercel preview URLs (*.vercel.app) are allowed by default via CORS_ORIGIN_REGEX
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Set true only when a trusted reverse proxy sets X-Forwarded-For
# TRUSTED_PROXY=false
# LangChain chat memory (optional — sliding window per session)
# CHAT_MEMORY_WINDOW_K=10
# CHAT_SESSION_TTL_SECONDS=86400
# DATABASE_PATH=./cities.db
DATABASE_PATH=/app/data/cities.db
# Open-Meteo outbound throttling (prevents 429 rate limits on startup / batch)
# PREWARM_CITIES_LIMIT=80
# OPEN_METEO_BATCH_CHUNK_SIZE=40
# OPEN_METEO_CHUNK_PAUSE_SECONDS=1.5
# City detail forecast (Open-Meteo can be slow from cloud hosts; default read timeout 35s)
# WEATHER_DETAIL_READ_TIMEOUT_SECONDS=35
# WEATHER_DETAIL_CONNECT_TIMEOUT_SECONDS=8
# WEATHER_DETAIL_MAX_RETRIES=4
# Structured logging (JSON when ENV=production) and LangSmith tracing
# ENV=production
# LOG_LEVEL=INFO
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=atmosmind-agent
# Resilience observability (Phase 0c): in-process counters at GET /api/_health/resilience
# ENABLE_RESILIENCE_ENDPOINT=false
# Phase 0a: share one Open-Meteo forecast fetch for city detail + lifestyle (dual-call elimination).
# Code default is false for backward compatibility; recommended production value is true (halves detail forecast calls).
WEATHER_DETAIL_SHARE_FORECAST=true
# Redis cache TTLs (seconds). Code defaults to 900 when unset. Longer TTL = fewer upstream calls, less freshness.
# WEATHER_TTL_SECONDS=1800
# WEATHER_DETAIL_TTL_SECONDS=1800
# AIR_QUALITY_TTL_SECONDS=3600
# Phase 4: weather provider failover (OpenWeatherMap free tier primary, Open-Meteo fallback)
# Uses /data/2.5/weather + /data/2.5/forecast (not One Call 3.0).
# WEATHER_PROVIDER_PRIMARY=openweathermap
# OPENWEATHER_API_KEY=your_openweather_api_key
# OPENWEATHER_MAX_RETRIES=3
# OPENWEATHER_RETRY_BASE_DELAY_SECONDS=1.0
# Phase 2 (ENABLE_STALE_WHILE_REVALIDATE=true): soft = freshness, hard = Redis SETEX
# ENABLE_STALE_WHILE_REVALIDATE=false
# ENABLE_CIRCUIT_BREAKER=false
# WEATHER_SOFT_TTL_SECONDS=1800
# WEATHER_HARD_TTL_SECONDS=7200
# WEATHER_DETAIL_SOFT_TTL_SECONDS=1800
# WEATHER_DETAIL_HARD_TTL_SECONDS=7200
# AIR_QUALITY_SOFT_TTL_SECONDS=3600
# AIR_QUALITY_HARD_TTL_SECONDS=21600
# CB_FAILURE_THRESHOLD=5
# CB_WINDOW_SECONDS=60
# CB_OPEN_SECONDS=60
